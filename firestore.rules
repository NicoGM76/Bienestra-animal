rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active";
    }

    function isCitizen() {
      return hasActiveProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeRole == "citizen"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(["citizen"]);
    }

    function isVeterinarian() {
      return hasActiveProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeRole == "veterinarian"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(["veterinarian"]);
    }

    function isAdministrator() {
      return hasActiveProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeRole == "administrator"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(["administrator"]);
    }

    function isCitizenProfile(data, uid) {
      return data.keys().hasAll([
        "uid",
        "name",
        "email",
        "roles",
        "activeRole",
        "accountType",
        "status",
        "createdAt"
      ])
      && data.uid == uid
      && data.roles == ["citizen"]
      && data.activeRole == "citizen"
      && data.accountType == "citizen"
      && data.status == "active";
    }

    function isActiveVeterinarian(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status == "active"
        && get(/databases/$(database)/documents/users/$(uid)).data.activeRole == "veterinarian"
        && get(/databases/$(database)/documents/users/$(uid)).data.roles.hasAny(["veterinarian"]);
    }

    function veterinarianStatusTransitionAllowed() {
      return (
          resource.data.status == "assigned"
          && request.resource.data.status == "in_progress"
        ) || (
          resource.data.status == "in_progress"
          && request.resource.data.status == "completed"
        );
    }

    match /users/{uid} {
      allow create: if ownsUserDocument(uid)
                    && isCitizenProfile(request.resource.data, uid);

      allow read: if ownsUserDocument(uid)
                  || isAdministrator();

      // Los roles institucionales se administran fuera del cliente en esta Beta.
      allow update: if false;
      allow delete: if false;
    }

    match /animals/{animalId} {
      allow create: if isCitizen()
                    && request.resource.data.mainResponsibleId == request.auth.uid
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == "active"
                    && request.resource.data.origin == "citizen";

      allow read: if (
                    isCitizen()
                    && resource.data.mainResponsibleId == request.auth.uid
                  )
                  || isAdministrator();

      allow update: if false;
      allow delete: if false;
    }

    match /cases/{caseId} {
      allow create: if isCitizen()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == "received"
                    && request.resource.data.municipality == "Zipaquirá"
                    && request.resource.data.type in ["lost", "found", "abuse"]
                    && request.resource.data.protectedIdentity == (request.resource.data.type == "abuse");

      allow read: if (
                    isCitizen()
                    && resource.data.createdBy == request.auth.uid
                  )
                  || (
                    isVeterinarian()
                    && resource.data.assignedTo == request.auth.uid
                  )
                  || isAdministrator();

      allow update: if (
                      isAdministrator()
                      && resource.data.status == "received"
                      && request.resource.data.status == "assigned"
                      && request.resource.data.assignedTo is string
                      && request.resource.data.assignedRole == "veterinarian"
                      && isActiveVeterinarian(request.resource.data.assignedTo)
                      && request.resource.data.assignedBy == request.auth.uid
                      && request.resource.data.assignedAt == request.time
                      && request.resource.data.updatedAt == request.time
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        "assignedTo",
                        "assignedRole",
                        "assignedBy",
                        "assignedAt",
                        "status",
                        "updatedAt"
                      ])
                    )
                    ||
                    (
                      isVeterinarian()
                      && resource.data.assignedTo == request.auth.uid
                      && request.resource.data.assignedTo == request.auth.uid
                      && (
                        (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
                          && veterinarianStatusTransitionAllowed()
                          && request.resource.data.updatedAt == request.time
                        )
                        ||
                        (
                          resource.data.status == "in_progress"
                          && request.resource.data.status == resource.data.status
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            "veterinaryDiagnosis",
                            "veterinaryObservations",
                            "veterinaryTreatment",
                            "veterinaryRecommendations",
                            "veterinaryUpdatedBy",
                            "veterinaryUpdatedAt",
                            "updatedAt"
                          ])
                          && request.resource.data.veterinaryDiagnosis is string
                          && request.resource.data.veterinaryTreatment is string
                          && request.resource.data.veterinaryUpdatedBy == request.auth.uid
                          && request.resource.data.veterinaryUpdatedAt == request.time
                          && request.resource.data.updatedAt == request.time
                        )
                      )
                    );

      allow delete: if false;
    }

    // Denegación por defecto para toda colección aún no implementada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
