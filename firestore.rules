rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active";
    }

    function isCitizen() {
      return hasActiveProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeRole == "citizen"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(["citizen"]);
    }

    function isVeterinarian() {
      return hasActiveProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeRole == "veterinarian"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(["veterinarian"]);
    }

    function isAdministrator() {
      return hasActiveProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeRole == "administrator"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(["administrator"]);
    }

    function isCitizenProfile(data, uid) {
      return data.keys().hasAll([
        "uid",
        "name",
        "email",
        "roles",
        "activeRole",
        "accountType",
        "status",
        "createdAt"
      ])
      && data.uid == uid
      && data.roles == ["citizen"]
      && data.activeRole == "citizen"
      && data.accountType == "citizen"
      && data.status == "active";
    }

    function isActiveVeterinarian(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status == "active"
        && get(/databases/$(database)/documents/users/$(uid)).data.activeRole == "veterinarian"
        && get(/databases/$(database)/documents/users/$(uid)).data.roles.hasAny(["veterinarian"]);
    }

    function caseWasReceived() {
      return !resource.data.keys().hasAny(["status"])
        || resource.data.status in ["received", "recibido", "Recibido", "new", "nuevo"];
    }

    function caseIsCompleted() {
      return resource.data.keys().hasAny(["status"])
        && resource.data.status in ["completed", "realizado", "finalizado", "cerrado", "closed"];
    }

    function veterinarianStatusTransitionAllowed() {
      return (
          resource.data.status in ["assigned", "asignado"]
          && request.resource.data.status == "in_progress"
        ) || (
          resource.data.status in ["in_progress", "en_atencion", "en atención"]
          && request.resource.data.status == "completed"
        );
    }

    match /users/{uid} {
      allow create: if ownsUserDocument(uid)
                    && isCitizenProfile(request.resource.data, uid);

      allow read: if ownsUserDocument(uid)
                  || isAdministrator();

      // Los roles institucionales se administran fuera del cliente.
      allow update: if false;
      allow delete: if false;
    }

    match /animals/{animalId} {
      allow create: if isCitizen()
                    && request.resource.data.mainResponsibleId == request.auth.uid
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == "active"
                    && request.resource.data.origin == "citizen";

      allow read: if (
                    isCitizen()
                    && resource.data.mainResponsibleId == request.auth.uid
                  )
                  || isAdministrator();

      allow update: if false;
      allow delete: if false;
    }

    match /cases/{caseId} {
      allow create: if isCitizen()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == "received"
                    && request.resource.data.municipality == "Zipaquirá"
                    && request.resource.data.type in ["lost", "found", "abuse"]
                    && request.resource.data.protectedIdentity == (request.resource.data.type == "abuse");

      allow read: if (
                    isCitizen()
                    && resource.data.createdBy == request.auth.uid
                  )
                  || (
                    isVeterinarian()
                    && resource.data.assignedTo == request.auth.uid
                  )
                  || isAdministrator();

      // 1) Administrador: asignación inicial received -> assigned.
      allow update: if (
                      isAdministrator()
                      && caseWasReceived()
                      && request.resource.data.status == "assigned"
                      && request.resource.data.assignedTo is string
                      && request.resource.data.assignedRole == "veterinarian"
                      && isActiveVeterinarian(request.resource.data.assignedTo)
                      && request.resource.data.assignedBy == request.auth.uid
                      && request.resource.data.assignedAt == request.time
                      && request.resource.data.updatedAt == request.time
                      && request.resource.data.schemaVersion == 2
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        "schemaVersion",
                        "assignedTo",
                        "assignedRole",
                        "assignedBy",
                        "assignedAt",
                        "status",
                        "updatedAt"
                      ])
                    )
                    ||
                    // 2) Administrador: reasignación mientras aún no inicia atención.
                    (
                      isAdministrator()
                      && resource.data.status in ["assigned", "asignado"]
                      && request.resource.data.status == resource.data.status
                      && request.resource.data.assignedTo is string
                      && request.resource.data.assignedTo != resource.data.assignedTo
                      && request.resource.data.assignedRole == "veterinarian"
                      && isActiveVeterinarian(request.resource.data.assignedTo)
                      && request.resource.data.assignedBy == request.auth.uid
                      && request.resource.data.assignedAt == request.time
                      && request.resource.data.updatedAt == request.time
                      && request.resource.data.schemaVersion == 2
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        "schemaVersion",
                        "assignedTo",
                        "assignedRole",
                        "assignedBy",
                        "assignedAt",
                        "updatedAt"
                      ])
                    )
                    ||
                    // 3) Administrador: prioridad institucional sin tocar el resto del caso.
                    (
                      isAdministrator()
                      && !caseIsCompleted()
                      && request.resource.data.finalPriority in ["low", "medium", "high", "critical"]
                      && request.resource.data.priorityReviewedBy == request.auth.uid
                      && request.resource.data.priorityReviewedAt == request.time
                      && request.resource.data.updatedAt == request.time
                      && request.resource.data.schemaVersion == 2
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        "schemaVersion",
                        "finalPriority",
                        "priorityReviewedBy",
                        "priorityReviewedAt",
                        "updatedAt"
                      ])
                    )
                    ||
                    // 4) Veterinario: transiciones de estado permitidas.
                    (
                      isVeterinarian()
                      && resource.data.assignedTo == request.auth.uid
                      && request.resource.data.assignedTo == request.auth.uid
                      && (
                        (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
                          && veterinarianStatusTransitionAllowed()
                          && request.resource.data.updatedAt == request.time
                        )
                        ||
                        // 5) Veterinario: última fotografía clínica del caso.
                        (
                          resource.data.status in ["in_progress", "en_atencion", "en atención"]
                          && request.resource.data.status == resource.data.status
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            "veterinaryDiagnosis",
                            "veterinaryObservations",
                            "veterinaryTreatment",
                            "veterinaryRecommendations",
                            "veterinaryUpdatedBy",
                            "veterinaryUpdatedAt",
                            "updatedAt"
                          ])
                          && request.resource.data.veterinaryDiagnosis is string
                          && request.resource.data.veterinaryTreatment is string
                          && request.resource.data.veterinaryUpdatedBy == request.auth.uid
                          && request.resource.data.veterinaryUpdatedAt == request.time
                          && request.resource.data.updatedAt == request.time
                        )
                      )
                    );

      allow delete: if false;

      match /attentions/{attentionId} {
        allow read: if isAdministrator()
                    || (
                      isVeterinarian()
                      && get(/databases/$(database)/documents/cases/$(caseId)).data.assignedTo == request.auth.uid
                    );

        allow create: if isVeterinarian()
                      && get(/databases/$(database)/documents/cases/$(caseId)).data.assignedTo == request.auth.uid
                      && get(/databases/$(database)/documents/cases/$(caseId)).data.status in ["in_progress", "en_atencion", "en atención"]
                      && request.resource.data.caseId == caseId
                      && request.resource.data.veterinarianUid == request.auth.uid
                      && request.resource.data.diagnosis is string
                      && request.resource.data.treatment is string
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.keys().hasAll([
                        "recordId",
                        "caseId",
                        "veterinarianUid",
                        "diagnosis",
                        "observations",
                        "treatment",
                        "recommendations",
                        "source",
                        "createdAt"
                      ]);

        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
                  && resource.data.recipientUid == request.auth.uid;

      allow create: if (
                      isAdministrator()
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.senderRole == "administrator"
                      && request.resource.data.type in ["case_assigned", "case_reassigned"]
                      && isActiveVeterinarian(request.resource.data.recipientUid)
                      && request.resource.data.read == false
                      && request.resource.data.createdAt == request.time
                    )
                    ||
                    (
                      isVeterinarian()
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.senderRole == "veterinarian"
                      && request.resource.data.type in ["case_in_progress", "case_completed"]
                      && get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.assignedTo == request.auth.uid
                      && get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.createdBy == request.resource.data.recipientUid
                      && request.resource.data.read == false
                      && request.resource.data.createdAt == request.time
                    );

      allow update: if signedIn()
                    && resource.data.recipientUid == request.auth.uid
                    && request.resource.data.recipientUid == request.auth.uid
                    && request.resource.data.read == true
                    && request.resource.data.readAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      "read",
                      "readAt"
                    ]);

      allow delete: if false;
    }

    // Denegación por defecto para toda colección aún no implementada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
